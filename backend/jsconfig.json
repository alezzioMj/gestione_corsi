{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2024",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "checkJs": false,
        "experimentalDecorators": false,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "esModuleInterop": true, 
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}